<table class="table table-cv table-sm table-borderless table-responsive">
  <!-- 要跳过的字段，不包含 image -->
  {% assign skip_basics = 'profiles,location' | split: ',' %}

  {%- comment -%}
    我们先定义两个变量：
    1) fields：累积生成的文本字段HTML
    2) image_value：头像URL
  {%- endcomment -%}
  {% assign fields = "" %}
  {% assign image_value = "" %}

  {%- comment -%}
    第1步：遍历 data[1]，把每个字段按键key、值value处理
  {%- endcomment -%}
  {% for content in data[1] %}
    {% assign key = content[0] %}
    {% assign value = content[1] %}

    <!-- 如果值为空，跳过 -->
    {% if value == "" %}
      {% continue %}
    {% endif %}

    <!-- 如果是 image，就保存到 image_value -->
    {% if key == "image" %}
      {% assign image_value = value %}
      {% continue %}
    {% endif %}

    <!-- 如果在 skip_basics（profiles,location）里，也跳过 -->
    {% if skip_basics contains key %}
      {% continue %}
    {% endif %}

    {%- comment -%}
      其余字段(如 name、school、major、email、phone等)
      拼成一段 <tr> ... </tr> HTML，累加到 fields 变量中
    {%- endcomment -%}
    {% capture row_html %}
      <tr>
        <td class="p-1 pr-2 font-weight-bold">
          <b>{{ key | capitalize }}</b>
        </td>
        <td class="p-1 pl-2 font-weight-light text">
          {% if key == 'url' %}
            <a href="{{ value }}" target="_blank" rel="noopener noreferrer">{{ value }}</a>
          {% elsif key == 'email' %}
            <a href="mailto:{{ value }}" target="_blank">{{ value }}</a>
          {% elsif key == 'phone' %}
            <a href="tel:{{ value }}">{{ value }}</a>
          {% else %}
            {{ value }}
          {% endif %}
        </td>
      </tr>
    {% endcapture %}
    {% assign fields = fields | append: row_html %}
  {% endfor %}

  {%- comment -%}
    第2步：通过一个两列表格布局
    左列展示 fields (Name, School, Major, …)，右列展示头像 (image_value)。
  {%- endcomment -%}
  <tr>
    <!-- 左侧字段 -->
    <td style="vertical-align: top; width: 70%;">
      <table class="table table-borderless" style="margin-bottom: 0;">
        {{ fields }}
      </table>
    </td>

    <!-- 右侧头像 -->
    <td style="vertical-align: top; width: 30%; text-align: center;">
      {% if image_value %}
        <img src="{{ image_value | relative_url }}" alt="Profile Photo"
             style="max-width: 150px; border-radius: 4px;">
      {% endif %}
    </td>
  </tr>
</table>
